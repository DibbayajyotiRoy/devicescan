<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Device Lens</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Permission descriptions -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Device Lens needs location access to detect nearby Wi-Fi and Bluetooth devices on your network.</string>

    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Device Lens scans for Bluetooth devices broadcasting nearby to check your environment.</string>

    <key>NSCameraUsageDescription</key>
    <string>Device Lens uses the camera in Locate Mode to help detect reflective lenses. No photos are taken or stored.</string>

    <key>NSMotionUsageDescription</key>
    <string>Device Lens reads the magnetometer to detect unusual electromagnetic activity that may indicate hidden electronics nearby.</string>

    <!-- Background tasks -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.devicelens.app.bgscan</string>
    </array>

    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
    </array>

    <!-- Offline enforcement -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- Minimum iOS version -->
    <key>MinimumOSVersion</key>
    <string>16.0</string>
</dict>
</plist>

# DeviceLens Backend Configuration

# PostgreSQL connection string (Neon)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/devicelens?sslmode=require

# Server
PORT=3000

# JWT secret (generate with: openssl rand -hex 32)
JWT_SECRET=

# Google OAuth (for normal user auth)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Superadmin credentials
ADMIN_PASSWORD=244466666

# Rate limiting (optional, defaults shown)
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# GeoIP (optional — skip for no country tracking)
# GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb

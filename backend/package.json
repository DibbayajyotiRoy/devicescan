{
  "name": "devicelens-backend",
  "version": "1.0.0",
  "description": "DeviceLens Intelligence API — device fingerprint matching and crowdsourced threat intelligence",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed"
  },
  "keywords": ["devicelens", "spy-camera", "iot", "fingerprint", "detection"],
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.4"
  }
}
